# Copy this file to .env when starting REVLab through scripts\start.ps1.
# Empty values keep the repository defaults.

# Ghidra installed by scripts\install-ghidra.ps1 uses ghidra\runtime by default.
REVLAB_ENABLE_GHIDRA=1
GHIDRA_HOME=ghidra/runtime

# Optional analysis output root. Leave empty to write under the repository.
REVLAB_OUTPUT_DIR=

# Optional PE tooling paths. The setup script installs these under tools\ by default.
UPX_PATH=tools/upx/upx.exe
PESIEVE_PATH=tools/pe-sieve/pe-sieve64.exe

# Dynamic-analysis controls. Keep VM mode disabled unless a configured VM is available.
REVLAB_SANDBOX_VM=0
REVLAB_SANDBOX_TIMEOUT=90
REVLAB_CAPTURE_DURATION=30
REVLAB_VM_SNAPSHOT=
REVLAB_VM_VMX=
REVLAB_VM_GUEST_PATH=C:\RevLab\sample.exe
